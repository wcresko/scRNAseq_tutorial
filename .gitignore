# Quarto
/.quarto/
_site/
*_files/
!docs/**/*_files/
*_cache/
_freeze/

# Generated tutorial outputs (created at runtime when students execute the
# code chunks). Figures/tables land in output/ModN/; pipeline hand-off .rds
# objects land in data/ (created next to the .qmd you run). Both are
# reproducible from the tutorials, so they are not tracked — and the paths are
# working-directory-relative now, so ignore these folders wherever they appear.
output/
data/

# Downloadable .rds datasets are generated into docs/rds/ by
# tools/build_workshop_rds.R (run in the background by render_all.sh) and ARE
# committed so they publish with the site — but the build log is just noise.
docs/rds/build_rds.log

# OS generated files
.DS_Store
Thumbs.db

# Editor files
*~
*.swp
*.bak

# Environment/credentials
.env

**/*.quarto_ipynb

# Python build artifacts
__pycache__/
*.pyc
